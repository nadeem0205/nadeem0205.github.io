---

interface Project {
  title: string;
  description: string;
  image: string;
  link: string;
  preview: string;
  status: string;
  tags: string[];
}

const projects: Project[] = [
  {
    title: "BRD-Generating LLM Chatbot",
    description: "AI-driven requirement assistant built with Mistral 7B, TinyLLaMA, and LLaVA, automating business requirement document generation and reducing manual effort by 70%.",
    image: "/images/brd-chatbot.svg",
    link: "https://www.linkedin.com/in/nadeemmuhammad",
    preview: "https://www.linkedin.com/in/nadeemmuhammad",
    status: "AI / LLM • Deployed",
    tags: ["Mistral 7B", "TinyLLaMA", "LLaVA", "Python"],
  },
  {
    title: "Kafka Event-Driven Microservices Hub",
    description: "Distributed asynchronous messaging architecture using Apache Kafka & ZooKeeper producers/consumers, efficiently handling 10k+ messages daily.",
    image: "/images/kafka-microservices.svg",
    link: "https://www.linkedin.com/in/nadeemmuhammad",
    preview: "https://www.linkedin.com/in/nadeemmuhammad",
    status: "Microservices • Production",
    tags: ["Apache Kafka", "ZooKeeper", "FastAPI", "Python"],
  },
  {
    title: "Playwright E2E & API Test Suites",
    description: "Automated UI, API, and cross-browser regression test suites using Playwright and Pytest, boosting automated test coverage by 85% and cutting release issues by 30%.",
    image: "/images/test-automation.svg",
    link: "https://www.linkedin.com/in/nadeemmuhammad",
    preview: "https://www.linkedin.com/in/nadeemmuhammad",
    status: "Automation • Production",
    tags: ["Playwright", "Pytest", "API Testing", "CI/CD"],
  },
  {
    title: "Airflow ETL & Batch Data Pipeline",
    description: "Automated batch processing and ETL data pipelines orchestrated via Apache Airflow and Celery with Redis caching, reducing API response times by 30%.",
    image: "/images/airflow-etl.svg",
    link: "https://www.linkedin.com/in/nadeemmuhammad",
    preview: "https://www.linkedin.com/in/nadeemmuhammad",
    status: "Data Engineering • Production",
    tags: ["Apache Airflow", "Celery", "Redis", "PostgreSQL"],
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Featured Work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects &amp; Systems</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="group border border-[#ffffff10] rounded-2xl p-4 bg-[#14141460] hover:border-[var(--sec)] transition-all duration-300">
            <a
              href={project.preview}
              target="_blank"
              rel="noopener noreferrer"
              class="block"
            >
              <div class="rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4 border border-[var(--white-icon-tr)]">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-48 md:h-64 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="px-1">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <h4 class="text-xl md:text-2xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors duration-300">
                    {project.title}
                  </h4>
                  <div class="flex gap-2 shrink-0">
                    <span
                      class="size-10 flex justify-center items-center text-[var(--white-icon)] group-hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-2 rounded-xl bg-[#1414149c] group-hover:bg-[var(--white-icon-tr)]"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="size-5"
                      >
                        <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                      </svg>
                    </span>
                  </div>
                </div>
                <p class="text-sm text-[var(--white-icon)] mb-3 leading-relaxed">
                  {project.description}
                </p>
                <div class="flex flex-wrap gap-2 items-center pt-1">
                  <span class="py-1 px-3 text-xs rounded-full bg-[var(--white-icon-tr)] text-[var(--sec)] border border-[var(--white-icon-tr)] font-medium">
                    {project.status}
                  </span>
                  {
                    project.tags.map((tag) => (
                      <span class="py-0.5 px-2 text-xs rounded-md bg-[#1414149c] text-[var(--white-icon)] border border-[var(--white-icon-tr)]">
                        {tag}
                      </span>
                    ))
                  }
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
    <a
      target="_blank"
      href="https://www.linkedin.com/in/nadeemmuhammad"
      aria-label="LinkedIn"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">View professional profile &amp; updates on LinkedIn</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
